# ─────────────────────────────────────────────────────────────────
# SkillEX – Local Developer Secrets
# Copy this file to application-local.properties and fill in values.
# application-local.properties is gitignored — NEVER commit it.
# Spring Boot picks this up automatically as the "local" profile.
# Start with: java -jar skillex.jar --spring.profiles.active=local
# Or set SPRING_PROFILES_ACTIVE=local in your IDE / run config.
# ─────────────────────────────────────────────────────────────────

# ── MySQL ─────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/skillex?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
APP_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
APP_JWT_EXPIRATION_MS=86400000

# ── Firebase Google popup auth (frontend popup -> backend JWT) ──
FIREBASE_GOOGLE_ENABLED=true
FIREBASE_PROJECT_ID=your_firebase_project_id
# Prefer path for local development
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-service-account.json
# Optional alternative to path: raw single-line JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── AI / Gemini ───────────────────────────────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Grok smart skill matching
GROK_API_KEY=your_grok_api_key_here
# Leave blank for auto-detection: gsk_ keys use Groq Cloud, xAI keys use api.x.ai.
GROK_ENDPOINT=
GROK_MODEL=grok-4.3
GROK_TIMEOUT_MS=12000

# ── OpenAI / Whisper (optional audio transcription) ─────────────
# Set if you want server-side audio chunk transcription via /transcribe
APP_OPENAI_API_KEY=your_openai_api_key_here

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Optional: intent matching overrides for local experiments ──
INTENT_CANDIDATE_POOL_FACTOR=4
INTENT_REASON_THRESHOLD=0.25
INTENT_EMBED_CACHE_MAX=4000
INTENT_EMBED_REDIS_ENABLED=false
INTENT_EMBED_REDIS_TTL_HOURS=24
INTENT_EMBED_REDIS_PREFIX=skillex:intent-embedding
INTENT_LEXICAL_WEIGHT=0.40
INTENT_EMBED_WEIGHT=0.60

# Optional Redis host/port when INTENT_EMBED_REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT_MS=2000

# ── Optional: catalog governance pipeline ──
CATALOG_AUTO_PROMOTE_ENABLED=true
CATALOG_AUTO_PROMOTE_MIN_OCCURRENCES=3
CATALOG_AUTO_PROMOTE_MIN_CONFIDENCE=70
CATALOG_PENDING_LIST_DEFAULT_LIMIT=50

# ── Local AI / Ollama / Gemma (Offline) ──────────────────────────
# Select your AI provider for session note summaries:
# - 'gemma'   : Uses local offline Ollama models (default)
# - 'gemini'  : Uses cloud-based Google Gemini (highly optimized)
# - 'fallback': Uses smart local offline extractive NLP summarization (needs no setup)
app.ai.notes.provider=gemma

# Local Ollama connection params (Ensure Ollama is running and model is pulled: 'ollama run gemma2:2b')
app.ai.gemma.url=http://localhost:11434/api/generate
app.ai.gemma.model=gemma2:2b

# ── Agora Video/Audio Call Room Credentials ──────────────────────
# Sign up at https://console.agora.io to get your App ID and App Certificate.
# These enable real-time WebRTC audio/video call streaming rooms.
app.agora.app-id=bf8f5464ba264a64b2c1fe2ccb7a87c3
app.agora.app-certificate=c3218a61f792462d884d0c0b035d353e

