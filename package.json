{
  "name": "skillex-root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\dev\\run-backend.ps1",
    "dev:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\dev\\run-frontend.ps1",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\dev\\smoke-fullstack.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start.ps1 -Stop"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "recharts": "^3.8.1"
  }
}
